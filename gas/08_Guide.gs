/** 「📖 使い方」シートを作り直す */
function setupGuideSheet_() {
  var rows = guideRows_();
  var sh = getOrCreateSheet_(SHEETS.GUIDE);
  sh.clear();
  sh.clearNotes();
  ensureGrid_(sh, 2, rows.length + 4);

  sh.getRange(1, 1, 1, 2).setValues([['ラクシフトAI 運営スプレッドシート 使い方', '']])
    .merge().setFontSize(14).setFontWeight('bold')
    .setBackground('#0f172a').setFontColor('#ffffff')
    .setVerticalAlignment('middle');
  sh.setRowHeight(1, 34);

  var values = rows.map(function (r) { return [r[1], r[2]]; });
  sh.getRange(2, 1, values.length, 2).setValues(values);

  for (var i = 0; i < rows.length; i++) {
    var row = i + 2;
    if (rows[i][0] === 'S') {
      sh.getRange(row, 1, 1, 2).merge()
        .setFontWeight('bold').setFontColor('#ffffff')
        .setBackground(GUIDE_SECTION_BG).setVerticalAlignment('middle');
      sh.setRowHeight(row, 26);
    } else if (rows[i][0] === 'H') {
      sh.getRange(row, 1, 1, 2).setFontWeight('bold').setBackground(GUIDE_HEAD_BG);
    } else {
      sh.getRange(row, 1).setFontWeight('bold').setVerticalAlignment('top');
      sh.getRange(row, 2).setVerticalAlignment('top');
    }
  }

  sh.getRange(1, 1, rows.length + 1, 2).setWrap(true);
  sh.setColumnWidth(1, 220);
  sh.setColumnWidth(2, 760);
  sh.setFrozenRows(1);
  if (sh.getMaxColumns() > 2) sh.hideColumns(3, sh.getMaxColumns() - 2);
  return sh;
}

/** メニュー: 使い方シートを開く (無ければ作る) */
function showGuide() {
  return guard_('使い方シートの表示', function () {
    var sh = setupGuideSheet_();
    ss_().setActiveSheet(sh);
    sh.setActiveSelection('A1');
  });
}
